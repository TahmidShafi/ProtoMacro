# ProtoMacro environment — copy to .env and fill in (all OPTIONAL).
# Without these, the app runs fully in guest/local mode. Never commit .env.
# The anon key is safe for the browser (protected by Row Level Security).
# NEVER put the service-role key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
